#!/usr/bin/env bash
set -euo pipefail

if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
  printf '%s\n' 'DeepThroat CLI installer' 'Windows: run install.ps1 from a versioned GitHub release.' 'Linux/macOS: build from source with Bun, then run:' './install --binary /absolute/path/to/deepthroat'
  exit 0
fi

if [[ "${1:-}" != "--binary" || -z "${2:-}" || "$#" -ne 2 ]]; then
  printf '%s\n' 'Packaged releases currently support Windows x64.' 'For Linux/macOS, build from source and use ./install --binary /absolute/path/to/deepthroat.' >&2
  exit 1
fi

binary="$2"
directory="${XDG_BIN_HOME:-$HOME/.local/bin}"
if [[ ! -f "$binary" || ! -x "$binary" ]]; then
  printf '%s\n' 'The supplied CLI binary must be an executable file.' >&2
  exit 1
fi
version="$("$binary" --version)"
if [[ ! "$version" =~ ^deepthroat\ v[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
  printf '%s\n' 'The supplied executable is not a stable DeepThroat CLI build.' >&2
  exit 1
fi
mkdir -p "$directory"
install -m 755 "$binary" "$directory/deepthroat"
printf '%s\n' "Installed $version to $directory/deepthroat" "Ensure $directory is on your PATH."
