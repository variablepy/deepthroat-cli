{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@deepthroat/server",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/variablepy/deepthroat-cli.git",
    "directory": "packages/server"
  },
  "files": [
    "dist"
  ],
  "exports": {
    "./*": "./src/*.ts"
  },
  "scripts": {
    "build": "bun run script/build.ts",
    "test": "bun test --only-failures",
    "typecheck": "bun check --no-script -b",
    "typecheck:tsc": "tsc -b",
    "probe:workerd": "bun run script/workerd-probe.ts"
  },
  "dependencies": {
    "@effect/platform-node": "catalog:",
    "@effect/platform-node-shared": "catalog:",
    "@deepthroat/core": "workspace:*",
    "@deepthroat/protocol": "workspace:*",
    "@deepthroat/schema": "workspace:*",
    "@deepthroat/simulation": "workspace:*",
    "@deepthroat/util": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@opencode-ai/pty": "0.3.1",
    "@deepthroat/client": "workspace:*",
    "@deepthroat/plugin": "workspace:*",
    "@tsconfig/bun": "catalog:",
    "@types/bun": "catalog:",
    "@typescript/native": "catalog:",
    "fast-check": "catalog:"
  },
  "private": true
}
